pipeline {
    agent any

    environment {
        WAR_BUILD_DIR = 'server/target'
        WAR_NAME = 'server.war'
        TOMCAT_WEBAPPS_DIR = '/opt/tomcat/webapps' // Change this if your Tomcat path is different
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'dev', url: 'https://github.com/tabbu9/cab-booking.git'
            }
        }

        stage('Build WAR with Maven') {
            steps {
                dir('server') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Deploy WAR to Tomcat') {
            steps {
                script {
                    def warFile = "${env.WAR_BUILD_DIR}/${env.WAR_NAME}"
                    sh """
                        echo "📦 Checking if WAR exists: ${warFile}"
                        if [ ! -f "${warFile}" ]; then
                            echo "❌ WAR file not found!"
                            exit 1
                        fi

                        echo "🧹 Cleaning previous deployment"
                        rm -rf ${TOMCAT_WEBAPPS_DIR}/server
                        rm -f ${TOMCAT_WEBAPPS_DIR}/${WAR_NAME}

                        echo "📤 Copying WAR to Tomcat webapps directory"
                        cp "${warFile}" ${TOMCAT_WEBAPPS_DIR}/

                        echo "🔁 Restarting Tomcat service"
                        sudo systemctl restart tomcat || sudo systemctl restart tomcat9

                        echo "✅ Deployment completed"
                    """
                }
            }
        }
    }

    post {
        success {
            echo '🚀 Deployment to local Tomcat completed successfully!'
        }
        failure {
            echo '❌ Deployment failed. Check logs for details.'
        }
    }
}
