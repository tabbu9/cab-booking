pipeline {
    agent any

    environment {
        NGINX_HOST = 'ec2-user@18.204.219.175'
        NGINX_TARGET_DIR = '/usr/share/nginx/html'
        WAR_BUILD_DIR = 'server/target'
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'dev', url: 'https://github.com/tabbu9/cab-booking.git'
            }
        }

        stage('Build WAR with Maven') {
            steps {
                dir('server') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Copy WAR to Nginx Server') {
            steps {
                sh '''
                    WAR_FILE=$(ls ${WAR_BUILD_DIR}/*.war 2>/dev/null | head -n 1)
                    if [ -z "$WAR_FILE" ]; then
                        echo "ERROR: WAR file not found"
                        exit 1
                    fi
                    echo "Copying $WAR_FILE to ${NGINX_HOST}:${NGINX_TARGET_DIR}/"
                    scp -o StrictHostKeyChecking=no "$WAR_FILE" ${NGINX_HOST}:${NGINX_TARGET_DIR}/
                '''
            }
        }
    }

    post {
        success {
            echo '✅ WAR successfully copied to Nginx server!'
        }
        failure {
            echo '❌ Build or Deployment failed.'
        }
    }
}
