pipeline {
    agent any

    environment {
        TOMCAT_ROOT_DIR = '/opt/apache-tomcat-10.0.23/webapps/server'
        WEBAPP_SOURCE = 'taxi-booking/src/main/webapp'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'dev', url: 'https://github.com/tabbu9/cab-booking.git'
            }
        }

        stage('Optional Build') {
            steps {
                dir('taxi-booking') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Deploy to Tomcat ROOT') {
            steps {
                script {
                    sh """
                        echo "📁 Ensuring Tomcat deployment directory exists..."
                        sudo mkdir -p ${TOMCAT_ROOT_DIR}

                        echo "📦 Cleaning old ROOT directory..."
                        sudo rm -rf ${TOMCAT_ROOT_DIR}/*

                        echo "📤 Copying webapp files to Tomcat ROOT..."
                        sudo cp -r ${WEBAPP_SOURCE}/* ${TOMCAT_ROOT_DIR}/

                        echo "✅ Deployment complete!"

                        # Uncomment below if you want to restart Tomcat automatically
                        # echo "🔁 Restarting Tomcat..."
                        # sudo systemctl restart tomcat
                    """
                }
            }
        }
    }

    post {
        success {
            echo '🚀 Deployed webapp to Tomcat successfully!'
        }
        failure {
            echo '❌ Deployment failed. Check logs and permissions.'
        }
    }
}
