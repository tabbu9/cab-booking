pipeline {
    agent any

    environment {
        WAR_BUILD_DIR = 'server/target'
        WAR_NAME = 'server.war'
        TOMCAT_WEBAPPS_DIR = '/opt/apache-tomcat-10.0.23/webapps'
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'dev', url: 'https://github.com/tabbu9/cab-booking.git'
            }
        }

        stage('Build WAR with Maven') {
            steps {
                dir('server') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Deploy WAR to Tomcat') {
            steps {
                script {
                    def warPath = "${env.WAR_BUILD_DIR}/${env.WAR_NAME}"
                    sh """
                        echo "📦 Checking if WAR exists at ${warPath}"
                        if [ ! -f "${warPath}" ]; then
                            echo "❌ WAR file not found!"
                            exit 1
                        fi

                        echo "🧹 Cleaning old WAR"
                        sudo -S rm -f ${TOMCAT_WEBAPPS_DIR}/${WAR_NAME}

                        echo "📤 Deploying new WAR to Tomcat"
                        sudo -S cp "${warPath}" "${TOMCAT_WEBAPPS_DIR}/"

                        echo "✅ WAR deployed successfully!"
                    """
                }
            }
        }
    }

    post {
        success {
            echo '🚀 WAR successfully deployed to Tomcat!'
        }
        failure {
            echo '❌ Deployment failed. Please check the logs.'
        }
    }
}
