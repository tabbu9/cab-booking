pipeline {
    agent any

    environment {
        WAR_BUILD_DIR = 'server/target'
        WAR_NAME = 'server.war'
        TOMCAT_HOME = '/opt/apache-tomcat-10.0.23'
        TOMCAT_WEBAPPS_DIR = "${TOMCAT_HOME}/webapps"
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'dev', url: 'https://github.com/tabbu9/cab-booking.git'
            }
        }

        stage('Build WAR with Maven') {
            steps {
                dir('server') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Deploy WAR to Tomcat') {
            steps {
                script {
                    def warPath = "${env.WAR_BUILD_DIR}/${env.WAR_NAME}"
                    sh """
                        echo "📦 Checking if WAR exists at ${warPath}"
                        if [ ! -f "${warPath}" ]; then
                            echo "❌ WAR file not found!"
                            exit 1
                        fi

                        echo "🛑 Stopping Tomcat"
                        sudo ${TOMCAT_HOME}/bin/shutdown.sh || echo "Tomcat may not have been running"

                        echo "🧹 Cleaning old deployment"
                        sudo rm -rf ${TOMCAT_WEBAPPS_DIR}/server
                        sudo rm -f ${TOMCAT_WEBAPPS_DIR}/${WAR_NAME}

                        echo "📤 Copying new WAR to Tomcat"
                        sudo cp "${warPath}" "${TOMCAT_WEBAPPS_DIR}/"

                        echo "🚀 Starting Tomcat"
                        sudo ${TOMCAT_HOME}/bin/startup.sh

                        echo "✅ Deployment complete!"
                    """
                }
            }
        }
    }

    post {
        success {
            echo '🚀 WAR successfully deployed to local Tomcat!'
        }
        failure {
            echo '❌ Deployment failed. Please check the console output.'
        }
    }
}
