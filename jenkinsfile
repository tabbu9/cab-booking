pipeline {
    agent any

    environment {
        TOMCAT_WEBAPPS = '/opt/apache-tomcat-10.0.23/webapps'
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'dev', url: 'https://github.com/tabbu9/cab-booking.git'
            }
        }

        stage('Build WAR with Maven') {
            steps {
                dir('server') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Deploy WAR to Tomcat') {
            steps {
                sh '''
                    WAR_FILE=$(ls server/target/*.war 2>/dev/null | head -n 1)
                    if [ -z "$WAR_FILE" ]; then
                        echo "ERROR: WAR file not found in server/target"
                        exit 1
                    fi
                    echo "Deploying $WAR_FILE to $TOMCAT_WEBAPPS"
                    cp "$WAR_FILE" "$TOMCAT_WEBAPPS/"
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Deployment successful!'
        }
        failure {
            echo '❌ Deployment failed.'
        }
    }
}
