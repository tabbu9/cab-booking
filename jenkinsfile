pipeline {
    agent any

    environment {
        WAR_BUILD_DIR = 'server/target'
        WAR_NAME = 'server.war'
        TOMCAT_WEBAPPS_DIR = '/opt/tomcat/webapps'  // adjust this path to your actual Tomcat location
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'dev', url: 'https://github.com/tabbu9/cab-booking.git'
            }
        }

        stage('Build WAR with Maven') {
            steps {
                dir('server') {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Deploy WAR to Tomcat') {
            steps {
                script {
                    def warPath = "${env.WAR_BUILD_DIR}/${env.WAR_NAME}"
                    sh """
                        if [ ! -f "${warPath}" ]; then
                            echo "❌ WAR file not found at ${warPath}"
                            exit 1
                        fi

                        echo "📦 Deploying WAR to Tomcat..."
                        cp -f "${warPath}" "${TOMCAT_WEBAPPS_DIR}/"
                        echo "✅ WAR copied to ${TOMCAT_WEBAPPS_DIR}/"

                        # Optional: restart Tomcat
                        systemctl restart tomcat || systemctl restart tomcat9 || echo "⚠️ Tomcat restart skipped or failed."
                    """
                }
            }
        }
    }

    post {
        success {
            echo '🚀 Deployment to local Tomcat completed successfully!'
        }
        failure {
            echo '❌ Deployment failed. Check logs for details.'
        }
    }
}
